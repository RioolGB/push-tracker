# ===== PushTracker (Docker Compose) =====
# Скопируйте в .env и заполните свои значения.
# ADMIN_PASSWORD, SESSION_SECRET, POSTBACK_TOKEN обязательны для docker compose up.

# Пароль администратора (один админ)
ADMIN_PASSWORD=change-me-strong-password

# Секрет для подписи сессионной httpOnly-cookie
SESSION_SECRET=change-me-random-secret

# Секретный токен postback от CPA-сети
POSTBACK_TOKEN=change-me-postback-secret

# Порог частоты кликов с одного IP в минуту (по умолчанию 30)
RATE_LIMIT_PER_MIN=30

# ---- Публикация ----
# Отдельного контейнера nginx нет: трафик отдаёт ваш системный nginx (порты 80/8080).
# Он проксирует домен трекера на порт ХОСТА TRACKER_PORT, а тот уже пробрасывается
# во внутренний порт приложения APP_PORT.
#
# TRACKER_PORT — свободный порт ХОСТА, на котором слушает контейнер app.
# Порт 3000 занят вашим текущим трекером, поэтому берём свободный (по умолчанию 3001).
# Задайте любой свободный и добавьте в вашем nginx server-блок, например:
#
#   server {
#       listen 80;
#       server_name push.my-domain.ru;
#       location / {
#           proxy_pass http://127.0.0.1:3001;
#           proxy_http_version 1.1;
#           proxy_set_header Host $host;
#           proxy_set_header X-Real-IP $remote_addr;
#           proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#           proxy_set_header X-Forwarded-Proto $scheme;
#       }
#   }
TRACKER_PORT=3001

# APP_PORT — ВНУТРЕННИЙ порт приложения (по умолчанию 3000). Наружу не смотрит,
# меняйте только если собираетесь менять и server-блок, и проброс порта.
APP_PORT=3000