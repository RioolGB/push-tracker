# ===== PushTracker (Docker Compose) =====
# Скопируйте в .env и заполните свои значения.
# ADMIN_PASSWORD, SESSION_SECRET, POSTBACK_TOKEN обязательны для docker compose up.

# Пароль администратора (один админ)
ADMIN_PASSWORD=change-me-strong-password

# Секрет для подписи сессионной httpOnly-cookie
SESSION_SECRET=change-me-random-secret

# Секретный токен postback от CPA-сети
POSTBACK_TOKEN=change-me-postback-secret

# Порог частоты кликов с одного IP в минуту (по умолчанию 30)
RATE_LIMIT_PER_MIN=30

# ---- Публикация (VPS) ----
# HTTP_PORT — порт ХОСТА, на котором nginx принимает запросы (пробрасывается в :80 контейнера).
# Если порт 80 уже занят другим сервисом — задайте другой, например 8080,
# и направьте свой домен на него (или проксируйте с внешнего nginx на этот порт).
HTTP_PORT=8080

# APP_PORT — ВНУТРЕННИЙ порт приложения (по умолчанию 3000). На хост НЕ публикуется,
# поэтому уже работающий на сервере трекер на :3000 не конфликтует.
APP_PORT=3000

# TRACKER_DOMAIN — домен/поддомен трекера для server_name в nginx.
# Оставьте пустым, чтобы nginx принимал запросы с любым Host.
TRACKER_DOMAIN=tracker.example.com