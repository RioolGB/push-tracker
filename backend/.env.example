# ===== PushTracker backend =====
# Порт HTTP-сервера
PORT=3000

# Пароль администратора (один админ). Меняется только перезапуском приложения.
ADMIN_PASSWORD=change-me-strong-password

# Секрет для подписи сессионной httpOnly-cookie и токенов
SESSION_SECRET=change-me-random-secret

# Секретный токен для postback от CPA-сети (защита от подделки)
POSTBACK_TOKEN=change-me-postback-secret

# Порог частоты кликов с одного IP в минуту
RATE_LIMIT_PER_MIN=30

# Redis
REDIS_URL=redis://localhost:6379
# Если Redis недоступен — приложение автоматически переключится на in-memory счётчики (для локальной разработки)

# Путь к файлу SQLite (относительно папки backend или абсолютный)
DATABASE_PATH=data/tracker.db

# Включить файловое логирование
LOG_FILE_ENABLED=true
# Каталог для лог-файлов
LOG_DIR=logs

# Доверять прокси (берите первый hop из X-Forwarded-For). Ставьте true за nginx.
TRUST_PROXY=true