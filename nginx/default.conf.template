# PushTracker — reverse proxy (nginx), шаблон для Docker Compose.
# Из переменных окружения подставляются:
#   TRACKER_DOMAIN — домен/поддомен трекера (пусто → принимает любой Host)
#   APP_PORT       — внутренний порт приложения (по умолчанию 3000)
# Собственные `$`-переменные nginx ($host, $remote_addr и т.д.) не подменяются.
#
# Публикация на хост управляется портом из docker-compose.yml (HTTP_PORT).
# Порт 3000 приложения НЕ публикуется на хост: он доступен только внутри
# сети compose, поэтому уже работающий на сервере трекер на :3000 не конфликтует.

server {
    listen 80;
    server_name ${TRACKER_DOMAIN};

    client_max_body_size 1m;
    proxy_cache off;

    location / {
        proxy_pass http://app:${APP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Первый hop в X-Forwarded-For = реальный IP посетителя
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}